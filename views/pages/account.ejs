<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Mi Cuenta - Agroferre Store</title>

  <link rel="stylesheet" href="/css/style.css">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

<%- include('../partials/header') %>

<main class="login-container">

  <div class="login-card account-card">

    <!-- Header -->

    <div class="account-header">

      <div class="account-avatar">
        <i class="fa-solid fa-user"></i>
      </div>

      <h2 class="login-title">
        Mi Cuenta
      </h2>

      <p class="login-subtitle">
        Administra tu información y tus compras
      </p>

    </div>

    <!-- Información -->

    <div class="account-info">

      <div class="account-item">

        <div class="account-icon">
          <i class="fa-solid fa-user"></i>
        </div>

        <div>
          <span class="account-label">Nombre</span>
          <p><%= user.nombre %></p>
        </div>

      </div>

      <div class="account-item">

        <div class="account-icon">
          <i class="fa-solid fa-envelope"></i>
        </div>

        <div>
          <span class="account-label">Email</span>
          <p><%= user.email %></p>
        </div>

      </div>

      <div class="account-item">

        <div class="account-icon">
          <i class="fa-solid fa-id-card"></i>
        </div>

        <div>
          <span class="account-label">ID de usuario</span>
          <p>#<%= user.id %></p>
        </div>

      </div>

    </div>

    <!-- Botones -->

    <div class="account-actions">

      <a href="/productos" class="account-btn blue-btn">

        <i class="fa-solid fa-cart-shopping"></i>

        Seguir comprando

      </a>

      <a href="/carrito" class="account-btn green-btn">

        <i class="fa-solid fa-basket-shopping"></i>

        Ver mi carrito

      </a>

    </div>

    <!-- Logout -->

    <a href="/logout" class="logout-link">

      <i class="fa-solid fa-right-from-bracket"></i>

      Cerrar sesión

    </a>

  </div>

</main>

<%- include('../partials/footer') %>

</body>
</html>