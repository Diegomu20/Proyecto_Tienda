<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error - Agroferre Store</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/header') %>
<main class="contenedor" style="text-align:center; padding:4rem 1rem;">
  <h2 style="color:var(--color-danger);">⚠️ <%= message || "Algo salió mal" %></h2>
  <p style="margin:1rem 0; color:var(--color-text-muted);">
    <%= typeof error !== 'undefined' ? error : "Por favor, intenta nuevamente o contacta al administrador." %>
  </p>
  <a href="/" class="btn">🏠 Volver al inicio</a>
  <a href="/productos" class="btn btn-outline" style="margin-left:0.5rem;">📦 Ver productos</a>
</main>
<%- include('../partials/footer') %>
</body>
</html>