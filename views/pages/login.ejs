<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Agroferre Store</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    .field-error { color: #e53e3e; font-size: 12px; margin-top: 4px; display: none; }
    .input-group.invalid input { border-color: #e53e3e; }
    .input-group.valid input   { border-color: #38a169; }
  </style>
</head>
<body>

<%- include('../partials/header') %>

<main class="login-container">
  <div class="login-card">

    <h2 class="login-title">
      <i class="fa-solid fa-user-lock"></i>
      Iniciar Sesión
    </h2>
    <p class="login-subtitle">Accede a tu cuenta de Agroferre Store</p>

    <% if (error) { %>
      <div class="error-box"><%= error %></div>
    <% } %>

    <form id="loginForm" action="/login" method="POST" class="login-form" novalidate>

      <input type="hidden" name="returnUrl" value="<%= returnUrl %>">

      <!-- Email -->
      <div class="form-group">
        <label for="email">Email</label>
        <div class="input-group" id="group-email">
          <i class="fa-solid fa-envelope"></i>
          <input type="email" id="email" name="email"
                 placeholder="tu@email.com" autocomplete="email">
        </div>
        <span class="field-error" id="err-email"></span>
      </div>

      <!-- Contraseña -->
      <div class="form-group">
        <label for="password">Contraseña</label>
        <div class="input-group" id="group-password">
          <i class="fa-solid fa-lock"></i>
          <input type="password" id="password" name="password"
                 placeholder="Tu contraseña" autocomplete="current-password">
        </div>
        <span class="field-error" id="err-password"></span>
      </div>

      <div class="remember-group">
        <input type="checkbox" name="rememberMe" id="rememberMe" value="true">
        <label for="rememberMe">Recordarme por 30 días</label>
      </div>

      <button type="submit" class="login-btn">
        <i class="fa-solid fa-right-to-bracket"></i> Ingresar
      </button>

    </form>

    <p class="register-link">
      ¿No tienes cuenta? <a href="/register">Regístrate aquí</a>
    </p>

  </div>
</main>

<%- include('../partials/footer') %>

<script>
function showError(errId, groupId, msg) {
  const e = document.getElementById(errId);
  const g = document.getElementById(groupId);
  e.textContent = msg; e.style.display = 'block';
  g.classList.add('invalid'); g.classList.remove('valid');
}
function clearError(errId, groupId) {
  const e = document.getElementById(errId);
  const g = document.getElementById(groupId);
  e.textContent = ''; e.style.display = 'none';
  g.classList.remove('invalid'); g.classList.add('valid');
}

function validateEmail() {
  const val = document.getElementById('email').value.trim();
  const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!val)           { showError('err-email', 'group-email', 'El email es obligatorio.'); return false; }
  if (!regex.test(val)) { showError('err-email', 'group-email', 'Ingresa un email con formato válido.'); return false; }
  clearError('err-email', 'group-email'); return true;
}

function validatePassword() {
  const val = document.getElementById('password').value;
  if (!val) { showError('err-password', 'group-password', 'La contraseña es obligatoria.'); return false; }
  clearError('err-password', 'group-password'); return true;
}

document.getElementById('email').addEventListener('input', validateEmail);
document.getElementById('password').addEventListener('input', validatePassword);

document.getElementById('loginForm').addEventListener('submit', function(e) {
  const ok = [validateEmail(), validatePassword()];
  if (ok.includes(false)) e.preventDefault();
});
</script>

</body>
</html>
