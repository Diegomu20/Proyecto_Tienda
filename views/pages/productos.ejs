<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catálogo - Agroferre Store</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/header') %>

<main class="contenedor">
  <h2>📦 Nuestros Productos</h2>
  
  <!-- Filtros -->
  <form class="categorias" method="GET" action="/productos">
    <input type="text" name="buscar" placeholder="Buscar..." value="<%= buscar %>" style="padding:0.5rem; border-radius:6px; border:1px solid #ccc;">
    <select name="categoria" onchange="this.form.submit()">
      <option value="todos" <%= categoria==='todos'?'selected':'' %>>Todas</option>
      <option value="agricola" <%= categoria==='agricola'?'selected':'' %>>🌾 Agrícola</option>
      <option value="veterinaria" <%= categoria==='veterinaria'?'selected':'' %>>🐄 Veterinaria</option>
      <option value="ferreteria" <%= categoria==='ferreteria'?'selected':'' %>>🔧 Ferretería</option>
    </select>
    <button type="submit" class="btn" style="width:auto;">🔍 Filtrar</button>
  </form>

  <!-- Grid de productos -->
  <div class="grid-productos">
    <% if (products.length === 0) { %>
      <p style="grid-column:1/-1; text-align:center; padding:2rem;">No hay productos en esta categoría.</p>
    <% } %>
    
    <% products.forEach(p => { %>
      <article class="card" data-id="<%= p.id %>">
        <img src="/img/<%= p.imagen %>" alt="<%= p.nombre %>" loading="lazy" onerror="this.src='/img/default.jpg'">
        <div class="card-content">
          <small style="color:var(--color-text-muted); text-transform:uppercase; font-size:0.75rem;"><%= p.categoria %></small>
          <h3><%= p.nombre %></h3>
          <p class="precio">$<%= Number(p.precio).toLocaleString() %></p>
          <span class="stock-badge <%= p.stock <= 5 ? 'stock-low' : 'stock-ok' %>">
            <%= p.stock <= 5 ? `⚠️ ${p.stock} u.` : '✅ Disponible' %>
          </span>
          
          <!-- ✅ BOTÓN PÚBLICO: Agregar al carrito -->
          <button type="button" class="btn add-to-cart-btn" 
                  data-id="<%= p.id %>" 
                  data-name="<%= p.nombre %>" 
                  data-price="<%= p.precio %>">
            🛒 Agregar al carrito
          </button>
        </div>
      </article>
    <% }) %>
  </div>
</main>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>