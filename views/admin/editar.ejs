<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Editar: <%= product.nombre %> | Admin</title>

  <link rel="stylesheet" href="/css/style.css">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

<%- include('../partials/adminHeader') %>

<main class="login-container">

  <div class="login-card admin-product-card">

    <h2 class="login-title">
      <i class="fa-solid fa-pen-to-square"></i>
      Editar Producto
    </h2>

    <p class="login-subtitle">
      Modifica la información de:
      <strong><%= product.nombre %></strong>
    </p>

    <% if (error) { %>

      <div class="error-box">
        <%= error %>
      </div>

    <% } %>

    <form
      action="/admin/editar/<%= product.id %>"
      method="POST"
      enctype="multipart/form-data"
      class="login-form"
    >

      <input type="hidden" name="id" value="<%= product.id %>">

      <!-- Nombre -->

      <div class="form-group">

        <label for="nombre">Nombre</label>

        <div class="input-group">

          <i class="fa-solid fa-tag"></i>

          <input
            type="text"
            id="nombre"
            name="nombre"
            value="<%= product.nombre %>"
            required
          >

        </div>

      </div>

      <!-- Categoría -->

      <div class="form-group">

        <label for="categoria">Categoría</label>

        <div class="input-group">

          <i class="fa-solid fa-layer-group"></i>

          <select
            name="categoria"
            id="categoria"
            required
            class="custom-select"
          >

            <% categorias.forEach(c => { %>

              <option
                value="<%= c %>"
                <%= product.categoria === c ? 'selected' : '' %>
              >
                <%= c.charAt(0).toUpperCase() + c.slice(1) %>
              </option>

            <% }) %>

          </select>

        </div>

      </div>

      <!-- Precio -->

      <div class="form-group">

        <label for="precio">Precio ($)</label>

        <div class="input-group">

          <i class="fa-solid fa-dollar-sign"></i>

          <input
            type="number"
            id="precio"
            name="precio"
            value="<%= product.precio %>"
            min="0"
            step="1000"
            required
          >

        </div>

      </div>

      <!-- Stock -->

      <div class="form-group">

        <label for="stock">Stock</label>

        <div class="input-group">

          <i class="fa-solid fa-boxes-stacked"></i>

          <input
            type="number"
            id="stock"
            name="stock"
            value="<%= product.stock %>"
            min="0"
            required
          >

        </div>

      </div>

      <!-- Imagen actual -->

      <div class="form-group">

        <label>Imagen actual</label>

        <% if (product.imagen) { %>

          <div class="current-image-container">

            <img
              src="/img/<%= product.imagen.startsWith('uploads/') ? product.imagen : 'uploads/' + product.imagen %>"
              alt="<%= product.nombre %>"
              class="current-product-image"
            >

          </div>

        <% } %>

      </div>

      <!-- Nueva imagen -->

      <div class="form-group">

        <label for="imagen">
          Cambiar imagen
        </label>

        <div class="file-upload">

          <label for="imagen" class="file-label">
            <i class="fa-solid fa-image"></i>
            Seleccionar nueva imagen
          </label>

          <input
            type="file"
            id="imagen"
            name="imagen"
            accept="image/*"
          >

        </div>

        <small class="file-help">
          Deja vacío para mantener la imagen actual
        </small>

        <div id="preview-container" class="preview-container">

          <img id="image-preview">

        </div>

      </div>

      <button type="submit" class="login-btn">

        <i class="fa-solid fa-floppy-disk"></i>

        Actualizar Producto

      </button>

    </form>

    <a href="/productos" class="back-btn">

      <i class="fa-solid fa-arrow-left"></i>

      Volver al catálogo

    </a>

  </div>

</main>

<script>
  document.getElementById('imagen').addEventListener('change', function(e) {

    const file = e.target.files[0];

    if (file) {

      const reader = new FileReader();

      reader.onload = function(e) {

        document.getElementById('image-preview').src = e.target.result;

        document.getElementById('preview-container').style.display = 'block';

      };

      reader.readAsDataURL(file);

    }

  });
</script>

<%- include('../partials/footer') %>

</body>
</html>