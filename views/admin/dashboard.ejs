<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Admin - Agroferre Store</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/adminHeader') %>

<main class="contenedor">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
    <h2>🛡️ Gestión de Productos</h2>
    <a href="/admin/crear" class="btn">➕ Nuevo Producto</a>
  </div>

  <div class="grid-productos">
    <% products.forEach(p => { %>
      <article class="card">
        <img src="/img/<%= p.imagen %>" alt="<%= p.nombre %>" style="height:160px;">
        <div class="card-content">
          <small style="color:var(--color-text-muted); text-transform:uppercase;"><%= p.categoria %></small>
          <h3><%= p.nombre %></h3>
          <p class="precio">$<%= Number(p.precio).toLocaleString() %></p>
          <p style="font-size:0.9rem;">Stock: <%= p.stock %></p>
          
          <!-- ✅ BOTONES ADMIN -->
          <div style="display:flex; gap:0.5rem; margin-top:0.5rem;">
            <a href="/admin/editar/<%= p.id %>" class="btn" style="flex:1; background:#1565C0;">✏️ Editar</a>
            <form action="/admin/eliminar/<%= p.id %>" method="POST" style="flex:1;" onsubmit="return confirm('¿Eliminar <%= p.nombre %>?\n\nEsta acción no se puede deshacer.');">
              <button type="submit" class="btn" style="background:#D32F2F;">🗑️ Eliminar</button>
            </form>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>