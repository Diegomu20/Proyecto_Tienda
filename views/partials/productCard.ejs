<%-- views/partials/productCard.ejs --%>
<article class="card" data-id="<%= product._id || product.id %>">
  <img 
    src="/img/<%= product.image || 'default.jpg' %>" 
    alt="<%= product.name %>" 
    loading="lazy" 
    onerror="this.src='/img/default.jpg'"
  >
  
  <div class="card-content">
    <small style="color: var(--color-text-muted); text-transform: uppercase; font-size: 0.75rem; font-weight: 600;">
      <%= product.category || 'General' %>
    </small>
    
    <h3 title="<%= product.name %>"><%= product.name %></h3>
    <p class="precio">$<%= Number(product.price || 0).toLocaleString() %></p>
    
    <% if (typeof product.stock !== 'undefined') { %>
      <% if (product.stock <= 5) { %>
        <span class="stock-badge stock-low">⚠️ Solo <%= product.stock %> u.</span>
      <% } else { %>
        <span class="stock-badge stock-ok">✅ Disponible</span>
      <% } %>
    <% } %>

    <button 
      type="button" 
      class="btn add-to-cart-btn" 
      data-id="<%= product._id || product.id %>" 
      data-name="<%= product.name %>" 
      data-price="<%= product.price %>"
      <%= (product.stock && product.stock <= 0) ? 'disabled' : '' %>
    >
      <%= (product.stock && product.stock <= 0) ? '❌ Agotado' : '🛒 Agregar al carrito' %>
    </button>
  </div>
</article>